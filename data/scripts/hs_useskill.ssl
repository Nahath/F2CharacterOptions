#include "DEFINE.H"
#include "SFALL.H"
#include "define_extra.h"

// Weapon ammo PID field — second dword of the WeaponItemData union at 0x40
// (same slot as OBJ_DATA_CUR_ACTION_POINT for critters, which shares the union)
#define OBJ_DATA_WEAPON_AMMO_PID    (0x40)

// ============================================================
// Script indices (0-based, from scripts.lst)
// ============================================================
#define SID_DOC_ANDREW      (93)    // VCAndy.int    — Doc Andrew, Vault City
#define SID_SALVATORE       (443)   // ncSalvat.int  — Mr. Salvatore, New Reno
#define SID_METZGER         (46)    // dcMetzge.int  — Metzger, The Den
#define SID_DORNAN          (718)   // Ccdrill.int   — Sgt. Dornan, Navarro
#define SID_JO              (102)   // mcJo.int      — Jo, Modoc
#define SID_ASCORTI         (810)   // RCAscort.int  — Mayor Ascorti, Redding
#define SID_MARGE_LEBARGE   (694)   // RCMarge.int   — Marge LeBarge, Redding
#define SID_DAN_MCGREW      (807)   // RCMcGrew.int  — Dan McGrew, Redding
#define SID_LYNETTE         (128)   // VCLynett.int  — First Citizen Lynette, Vault City
#define SID_VALERIE         (972)   // VCMainWk.int  — Valerie (Vic's daughter), Vault City
#define SID_FESTUS          (131)   // GCFestus.int  — Festus, Gecko
#define SID_ROSE            (108)   // mcRose.int    — Rose, Modoc
#define SID_LIZ             (597)   // hcLiz.int     — Liz, Broken Hills
#define SID_SCORP           (1173)  // hcScorp.int   — Intelligent Radscorpion, Broken Hills
#define SID_BRIAN           (1132)  // hcBrian.int   — Brian (Power Technician), Broken Hills
#define SID_DOC_JUBILEE     (463)   // SCDocJub.int  — Doc Jubilee, NCR
#define SID_FERGUS          (521)   // SCFergus.int  — Fergus (Congress House receptionist), NCR
#define SID_WESTIN          (471)   // SCWestin.int  — Westin, NCR
#define SID_RAUL            (1053)  // CcRaul.int    — Raul, Navarro
#define SID_KEN_LEE         (856)   // FCKenLee.int  — Ken Lee, San Francisco
#define SID_BIG_JESUS       (456)   // ncBigJes.int  — Big Jesus Mordino, New Reno
#define SID_BISHOP          (420)   // ncBishop.int  — John Bishop, New Reno
#define SID_ORVILLE         (439)   // ncOrvill.int  — Orville Wright, New Reno
#define SID_PRESIDENT       (803)   // qhPrzRch.int  — President Richardson, Enclave

// ============================================================
// Item PIDs
// ============================================================
#define PID_SUPER_STIMPAK       (144)
#define PID_ALIEN_BLASTER       (120)
#define PID_STIMPAK             (40)
#define PID_ADV_POWER_ARMOR_MK2 (349)
#define PID_10MM_SMG            (9)
#define PID_10MM_JHP            (29)
#define PID_MICRO_FUSION_CELL   (39)
#define PID_SNIPER_RIFLE        (143)
#define PID_PLASMA_PISTOL_EXT   (406)
#define PID_SUPER_TOOL_KIT      (308)
#define PID_HOLY_HAND_GRENADE   (421)
#define PID_CATTLE_PROD         (160)
#define PID_DEANS_ELECTRONICS   (76)
#define PID_GUNS_AND_BULLETS    (102)
#define PID_ELEC_LOCKPICK_MK2   (411)
#define PID_RADAWAY             (48)
#define PID_FUZZY_PAINTING      (78)
#define PID_2MM_EC              (358)
#define PID_4_7MM_CASELESS      (359)
#define PID_BOZAR               (350)
#define PID_HK_P90C             (296)
#define PID_VINDICATOR          (395)
#define PID_HK_G11E             (391)
#define PID_PANCOR_JACKHAMMER   (354)
#define PID_RED_RYDER_LE        (162)
#define PID_BB_AMMO             (163)
#define PID_PLASTIC_EXPLOSIVES  (85)
#define PID_PRESIDENTIAL_KEY    (495)

// Fuzzy Painting (PID 78) has ScriptID=-1 in the proto. Doc Jubilee attaches
// SIpaint.int (index 953) to the object at runtime; that script marks Vault 13
// on the world map when the player examines it. Replicate by using create_object_sid.
#define SID_SIPOINT             (954)   // SIpaint.int

// Ascorti: top up to this many caps so player can steal them.
#define ASCORTI_CAPS_TARGET     (1500)

// President: already has 1 key (original stays lootable on death).
// Inject up to 2 total so player can steal a copy.
#define PRESIDENT_KEY_TARGET    (2)

procedure start;
procedure count_pid(variable target, variable pid);
procedure inject(variable target, variable pid, variable want);
procedure inject_weapon(variable target, variable pid);

// Returns count of items with matching PID in target's inventory.
procedure count_pid(variable target, variable pid)
begin
   variable n := 0;
   variable i := 0;
   while (i < inven_count(target)) do begin
      if (obj_pid(inven_ptr(target, i)) == pid) then n += 1;
      i += 1;
   end
   return n;
end

// Tops up target's inventory to `want` items of `pid`. Returns 0.
procedure inject(variable target, variable pid, variable want)
begin
   variable have := count_pid(target, pid);
   while (have < want) do begin
      add_obj_to_inven(target, create_object(pid, 0, 0));
      have += 1;
   end
   return 0;
end

// Creates one weapon of `pid`, loads it with ammo from the proto, and adds it
// to target's inventory. No-op if target already has one. Returns 0.
procedure inject_weapon(variable target, variable pid)
begin
   if (count_pid(target, pid) >= 1) then return 0;
   variable weapon_obj := create_object(pid, 0, 0);
   variable ammo_pid   := get_proto_data(pid, PROTO_WP_AMMO_PID);
   variable mag_size   := get_proto_data(pid, PROTO_WP_MAG_SIZE);
   if (ammo_pid > 0) then begin
      set_object_data(weapon_obj, OBJ_DATA_CUR_CHARGES, mag_size);
      set_object_data(weapon_obj, OBJ_DATA_WEAPON_AMMO_PID, ammo_pid);
   end
   add_obj_to_inven(target, weapon_obj);
   return 0;
end

procedure start
begin
   if game_loaded then return;

   variable user   := get_sfall_arg;   // arg0
   variable target := get_sfall_arg;   // arg1
   variable skill  := get_sfall_arg;   // arg2
   get_sfall_arg;                       // arg3 skill bonus, unused

   if (user != dude_obj or skill != SKILL_STEAL) then begin
      set_sfall_return(-1);
      return;
   end
   if (not has_trait(TRAIT_PERK, dude_obj, PERK_thief_perk)) then begin
      set_sfall_return(-1);
      return;
   end

   variable sid := get_script(target);
   variable r;   // scratch for user-defined procedure return values
   variable cur; // scratch for caps check

   if      (sid == SID_DOC_ANDREW)  then r := inject(target, PID_SUPER_STIMPAK, 2);
   else if (sid == SID_SALVATORE)   then r := inject_weapon(target, PID_ALIEN_BLASTER);
   else if (sid == SID_METZGER)     then r := inject(target, PID_STIMPAK, 3);
   else if (sid == SID_DORNAN)      then r := inject(target, PID_ADV_POWER_ARMOR_MK2, 1);
   else if (sid == SID_JO)          then begin
      r := inject_weapon(target, PID_10MM_SMG);
      r := inject(target, PID_10MM_JHP, 2);
   end
   else if (sid == SID_ASCORTI) then begin
      cur := item_caps_total(target);
      if (cur < ASCORTI_CAPS_TARGET) then
         item_caps_adjust(target, ASCORTI_CAPS_TARGET - cur);
   end
   else if (sid == SID_MARGE_LEBARGE) then r := inject(target, PID_MICRO_FUSION_CELL, 3);
   else if (sid == SID_DAN_MCGREW)    then r := inject_weapon(target, PID_SNIPER_RIFLE);
   else if (sid == SID_LYNETTE)       then r := inject_weapon(target, PID_PLASMA_PISTOL_EXT);
   else if (sid == SID_VALERIE)       then r := inject(target, PID_SUPER_TOOL_KIT, 1);
   else if (sid == SID_FESTUS)        then r := inject(target, PID_HOLY_HAND_GRENADE, 1);
   else if (sid == SID_ROSE)          then r := inject(target, PID_CATTLE_PROD, 1);
   else if (sid == SID_LIZ)           then begin
      r := inject(target, PID_DEANS_ELECTRONICS, 2);
      r := inject(target, PID_GUNS_AND_BULLETS, 2);
   end
   else if (sid == SID_SCORP)         then r := inject(target, PID_ELEC_LOCKPICK_MK2, 1);
   else if (sid == SID_BRIAN)         then r := inject(target, PID_RADAWAY, 2);
   else if (sid == SID_DOC_JUBILEE)   then begin
      r := count_pid(target, PID_FUZZY_PAINTING);
      if (r < 1) then
         add_obj_to_inven(target, create_object_sid(PID_FUZZY_PAINTING, 0, 0, SID_SIPOINT));
   end
   else if (sid == SID_FERGUS)        then begin
      r := inject(target, PID_2MM_EC, 2);
      r := inject(target, PID_4_7MM_CASELESS, 2);
   end
   else if (sid == SID_WESTIN)        then begin
      r := inject_weapon(target, PID_BOZAR);
      r := inject(target, PID_PLASTIC_EXPLOSIVES, 2);
   end
   else if (sid == SID_RAUL)          then begin
      r := inject_weapon(target, PID_HK_P90C);
      r := inject(target, PID_PLASTIC_EXPLOSIVES, 2);
   end
   else if (sid == SID_KEN_LEE)       then begin
      r := inject_weapon(target, PID_VINDICATOR);
      r := inject(target, PID_4_7MM_CASELESS, 2);
   end
   else if (sid == SID_BIG_JESUS)     then begin
      r := inject_weapon(target, PID_HK_G11E);
      r := inject(target, PID_4_7MM_CASELESS, 1);
   end
   else if (sid == SID_BISHOP)        then r := inject_weapon(target, PID_PANCOR_JACKHAMMER);
   else if (sid == SID_ORVILLE)       then begin
      r := inject_weapon(target, PID_RED_RYDER_LE);
      r := inject(target, PID_BB_AMMO, 1);
   end
   else if (sid == SID_PRESIDENT)     then r := inject(target, PID_PRESIDENTIAL_KEY, PRESIDENT_KEY_TARGET);

   set_sfall_return(-1);
end
