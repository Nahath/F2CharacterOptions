/**
 * gl_goris_armor.ssl
 * Global script: auto-equips Bridgekeeper's Robes on Goris.
 *
 * The engine's "Use Best Armor" button has an upstream check that silently
 * skips Goris (vanilla behavior — Goris can't wear armor in base F2).
 * This script works around it: every HEARTBEAT_FRAMES frames, if Goris is
 * in the party, has no armor equipped, and has the robes in his inventory,
 * wield_obj_critter force-equips them directly.
 *
 * Requires: Sfall 4.x or newer.
 */

#include "DEFINE.H"
#include "SFALL.H"
#include "define_extra.h"

/* obj_pid() on a critter returns (0x01000000 | file_number).
 * PID_GORIS_BASE confirmed from RPU critrpid.h and fallout2-re source.
 * Stage variants 319-324: unverified; may be RPU-only leveling protos. */
#define PID_GORIS_BASE    (16777216 + 152)
#define PID_GORIS_STAGE1  (16777216 + 319)
#define PID_GORIS_STAGE2  (16777216 + 320)
#define PID_GORIS_STAGE3  (16777216 + 321)
#define PID_GORIS_STAGE4  (16777216 + 322)
#define PID_GORIS_STAGE5  (16777216 + 323)
#define PID_GORIS_STAGE6  (16777216 + 324)

#define PID_BRIDGEKEEPERS_ROBES  524

#define is_goris_pid(p) ((p) == PID_GORIS_BASE or (p) == PID_GORIS_STAGE1 or (p) == PID_GORIS_STAGE2 or (p) == PID_GORIS_STAGE3 or (p) == PID_GORIS_STAGE4 or (p) == PID_GORIS_STAGE5 or (p) == PID_GORIS_STAGE6)

#define HEARTBEAT_FRAMES  30

procedure start;

procedure start begin
    if game_loaded then begin
        set_global_script_repeat(HEARTBEAT_FRAMES);
    end

    variable members := party_member_list(0);
    variable member;
    foreach member in members begin
        if (not is_goris_pid(obj_pid(member))) then continue;

        // Goris found — skip if already wearing something
        if (critter_inven_obj(member, INVEN_TYPE_WORN) != 0) then break;

        // Search his inventory for the robes
        variable i;
        variable count := inven_count(member);
        for (i := 0; i < count; i := i + 1) begin
            variable item := inven_ptr(member, i);
            if (obj_pid(item) == PID_BRIDGEKEEPERS_ROBES) then begin
                wield_obj_critter(member, item);
                break;
            end
        end
        break;
    end
end
